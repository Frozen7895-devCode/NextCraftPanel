# NexCraft Panel — configuration. Copiez ce fichier en « .env » (install.sh / install.bat le font pour vous)
# puis adaptez-le. Les variables d'environnement NEXCRAFT_* ont priorité sur ce fichier.
# Redémarrez le panel après toute modification.

# --- Réseau --------------------------------------------------------------------------------------
# Adresse d'écoute. 127.0.0.1 = accessible uniquement depuis cette machine (recommandé).
NEXCRAFT_HOST=127.0.0.1
NEXCRAFT_PORT=8080
# Noms d'hôte acceptés dans l'en-tête Host (protection contre le « DNS rebinding »).
# Si vous accédez au panel par une autre adresse (nom de domaine, IP du réseau local), ajoutez-la ici.
NEXCRAFT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# La création du premier compte administrateur n'est autorisée que depuis la machine locale.
# Mettre « true » uniquement si vous devez la faire à distance (à vos risques).
NEXCRAFT_ALLOW_REMOTE_SETUP=false

# --- HTTPS direct (optionnel ; sinon utilisez un reverse proxy, voir README) ---------------------
NEXCRAFT_SSL_CERTFILE=
NEXCRAFT_SSL_KEYFILE=
# Derrière un reverse proxy : faire confiance aux en-têtes X-Forwarded-* venant de ces adresses.
NEXCRAFT_PROXY_HEADERS=false
NEXCRAFT_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Dossiers (relatifs à la racine du projet, ou chemins absolus) -------------------------------
NEXCRAFT_DATA_DIR=./data
NEXCRAFT_SERVER_DIR=./server
NEXCRAFT_BACKUP_DIR=./backups
NEXCRAFT_LOG_DIR=./logs

# --- Sessions et sécurité ------------------------------------------------------------------------
# Cookies « Secure » : auto (selon HTTPS), true ou false.
NEXCRAFT_SECURE_COOKIES=auto
NEXCRAFT_SESSION_HOURS=12
NEXCRAFT_IDLE_MINUTES=120
NEXCRAFT_LOGIN_MAX_FAILURES=5
NEXCRAFT_LOGIN_WINDOW_MINUTES=15

# --- Fichiers ------------------------------------------------------------------------------------
NEXCRAFT_MAX_UPLOAD_MB=512
NEXCRAFT_MAX_EXTRACT_MB=4096
NEXCRAFT_MAX_EDIT_KB=2048

# --- Serveur Minecraft ---------------------------------------------------------------------------
# Variables d'environnement que le panel a le droit de transmettre au processus Java.
NEXCRAFT_ENV_ALLOWLIST=TZ,LANG,LC_ALL,JAVA_HOME,MALLOC_ARENA_MAX

# --- Téléchargement de serveurs ------------------------------------------------------------------
# URL ou e-mail de contact placé dans le User-Agent (PaperMC l'exige pour son API de téléchargement).
NEXCRAFT_CONTACT=
